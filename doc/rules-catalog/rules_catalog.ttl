# ReMoM rules catalog: the game calculations rules profiles decide, and their results per profile.
# Generated by tools/rules_catalog from assets/rules/catalog.lua and the profiles; do not edit.
# One triple per line, so it also reads as a table (tools/rules_catalog/ttl_to_table.py).

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix remom: <https://github.com/jbalcomb/remom/ns/rules#> .
@prefix calc: <https://github.com/jbalcomb/remom/ns/rules/calculation/> .
@prefix input: <https://github.com/jbalcomb/remom/ns/rules/input/> .
@prefix dp: <https://github.com/jbalcomb/remom/ns/rules/datapoint/> .
@prefix profile: <https://github.com/jbalcomb/remom/ns/rules/profile/> .
@prefix val: <https://github.com/jbalcomb/remom/ns/rules/value/> .

remom:Calculation rdf:type rdfs:Class .
remom:Calculation rdfs:comment "A game calculation a rules profile decides." .
remom:Input rdf:type rdfs:Class .
remom:Input rdfs:comment "One argument of a calculation." .
remom:DataPoint rdf:type rdfs:Class .
remom:DataPoint rdfs:comment "A named set of arguments whose result is compared across profiles." .
remom:Profile rdf:type rdfs:Class .
remom:Profile rdfs:comment "A rules profile: a game version or mod (assets/rules/<id>/)." .
remom:Value rdf:type rdfs:Class .
remom:Value rdfs:comment "The result of one data point under one profile." .
remom:rule rdf:type rdf:Property .
remom:rule rdfs:comment "Name of the rule function in the profiles (rules.<rule>)." .
remom:cFunction rdf:type rdf:Property .
remom:cFunction rdfs:comment "C function that asks the rules profile." .
remom:cOriginal rdf:type rdf:Property .
remom:cOriginal rdfs:comment "Faithful 1.31 C function the original profile is tested against." .
remom:cFile rdf:type rdf:Property .
remom:cFile rdfs:comment "Source file of the C functions." .
remom:wzd rdf:type rdf:Property .
remom:wzd rdfs:comment "Segment/procedure of the function in the 1.31 executable (WIZARDS.EXE)." .
remom:drake178 rdf:type rdf:Property .
remom:drake178 rdfs:comment "drake178's name for the function." .
remom:unit rdf:type rdf:Property .
remom:unit rdfs:comment "Unit of the result." .
remom:input rdf:type rdf:Property .
remom:input rdfs:comment "An input of the calculation." .
remom:position rdf:type rdf:Property .
remom:position rdfs:comment "1-based position of an input among the arguments." .
remom:calculation rdf:type rdf:Property .
remom:calculation rdfs:comment "The calculation a data point or value belongs to." .
remom:argument rdf:type rdf:Property .
remom:argument rdfs:comment "The data point's arguments, in input order, as text." .
remom:dataPoint rdf:type rdf:Property .
remom:dataPoint rdfs:comment "The data point a value is for." .
remom:profile rdf:type rdf:Property .
remom:profile rdfs:comment "The profile a value is for." .
remom:value rdf:type rdf:Property .
remom:value rdfs:comment "The result." .
remom:base rdf:type rdf:Property .
remom:base rdfs:comment "The profile a profile starts from." .
remom:status rdf:type rdf:Property .
remom:status rdfs:comment "How far a profile's version of a calculation is confirmed." .
remom:source rdf:type rdf:Property .
remom:source rdfs:comment "Where a profile's version of a calculation comes from." .
remom:note rdf:type rdf:Property .
remom:note rdfs:comment "Anything else a profile says about its version of a calculation." .
remom:about rdf:type rdf:Property .
remom:about rdfs:comment "Links a profile's statement (status, source, note) to the calculation it is about." .

calc:square_production_bonus rdf:type remom:Calculation .
calc:square_production_bonus remom:rule "square_production_bonus" .
calc:square_production_bonus remom:cFile "MoM/src/Terrain.c" .
calc:square_production_bonus remom:cFunction "Square_Production_Bonus" .
calc:square_production_bonus remom:cOriginal "Square_Production_Bonus_Original" .
calc:square_production_bonus rdfs:comment "Production bonus (%) one square of a city's area gives that city." .
calc:square_production_bonus remom:drake178 "TILE_GetProd()" .
calc:square_production_bonus rdfs:label "Square production bonus" .
calc:square_production_bonus remom:unit "percent" .
calc:square_production_bonus remom:wzd "s161p04" .
calc:square_production_bonus remom:input input:square_production_bonus-terrain_type .
input:square_production_bonus-terrain_type rdf:type remom:Input .
input:square_production_bonus-terrain_type rdfs:label "terrain_type" .
input:square_production_bonus-terrain_type rdfs:comment "1.31 terrain type of the square" .
input:square_production_bonus-terrain_type remom:position 1 .
calc:square_production_bonus remom:input input:square_production_bonus-gaias_blessing .
input:square_production_bonus-gaias_blessing rdf:type remom:Input .
input:square_production_bonus-gaias_blessing rdfs:label "gaias_blessing" .
input:square_production_bonus-gaias_blessing rdfs:comment "1 if the city has Gaia's Blessing" .
input:square_production_bonus-gaias_blessing remom:position 2 .
calc:square_production_bonus remom:input input:square_production_bonus-shared .
input:square_production_bonus-shared rdf:type remom:Input .
input:square_production_bonus-shared rdfs:label "shared" .
input:square_production_bonus-shared rdfs:comment "1 if the square is also in another city's area" .
input:square_production_bonus-shared remom:position 3 .
